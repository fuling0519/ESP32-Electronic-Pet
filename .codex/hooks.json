{
  "description": "Require a project-plan review before commits in this repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib,runpy,subprocess,sys; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.argv=['plan_review.py','hook']; runpy.run_path(str(pathlib.Path(root)/'tools'/'plan_review.py'),run_name='__main__')\"",
            "timeout": 15,
            "statusMessage": "Checking project-plan review before commit"
          }
        ]
      }
    ]
  }
}
